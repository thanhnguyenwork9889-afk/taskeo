# Môi trường STAGING = Vercel Preview (nhánh develop). Đây chỉ là danh sách biến:
# đặt giá trị trong Vercel → Settings → Environment Variables → Preview. KHÔNG commit giá trị thật.
# Xem docs/01-environment.md.

NEXT_PUBLIC_APP_ENV="staging"

# Bắt buộc đủ cả 5 biến: staging không có chế độ demo, thiếu biến là bị chặn truy cập.

# Database riêng cho staging: Neon branch `staging` (không dùng chung với production).
# DATABASE_URL = chuỗi có pooling; DIRECT_URL = chuỗi trực tiếp, cho `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Secret riêng cho staging: npx auth secret
AUTH_SECRET=""

# OAuth client cho staging. Redirect URI: https://<domain-staging>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Khoá riêng cho staging (32 byte, base64)
TOKEN_ENCRYPTION_KEY=""
