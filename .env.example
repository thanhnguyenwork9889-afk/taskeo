# Sao chép thành .env.local rồi điền giá trị. KHÔNG commit file .env.local.
# Thiếu một trong các biến AUTH_* hoặc DATABASE_URL thì app chạy ở chế độ demo
# (dữ liệu mẫu, lưu trên trình duyệt, không đăng nhập).

# Postgres (Neon / Supabase)
DATABASE_URL="postgresql://user:password@host:5432/workspace?sslmode=require"

# Auth.js — tạo bằng: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google (và domain Vercel)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Khoá mã hoá token Google trong DB (32 byte, base64).
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""
