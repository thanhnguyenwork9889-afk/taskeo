# Môi trường DEVELOPMENT (máy local). Sao chép thành .env.local rồi điền giá trị.
# KHÔNG commit file .env.local. Hai môi trường: xem docs/01-environment.md.
# Mẫu cho production: .env.production.example.

# development | production. Đặt tường minh: `next start` chạy với
# NODE_ENV=production nên không có biến này sẽ bị coi là production.
NEXT_PUBLIC_APP_ENV="development"

# Chỉ với `npm run dev`: để trống cả 5 biến dưới đây thì app chạy chế độ demo
# (dữ liệu mẫu, lưu trên trình duyệt, không đăng nhập). Điền một phần → bị chặn.
# DIRECT_URL không tính vào 5 biến này: chỉ Prisma CLI dùng.

# Postgres trên Neon, branch `dev` — database riêng cho development.
# Neon → branch dev → Connect: DATABASE_URL lấy chuỗi có pooling (host có "-pooler"),
# DIRECT_URL lấy chuỗi tắt pooling (Prisma CLI dùng để migrate). Xem docs/03-database.md.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js — tạo bằng: npx auth secret
AUTH_SECRET=""

# Google Cloud Console → APIs & Services → Credentials → OAuth Client ID (Web)
# Redirect URI: http://localhost:3000/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Khoá mã hoá token Google trong DB (32 byte, base64).
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=""

# Google Picker (chọn file Drive có sẵn để gắn vào Taskeo) — TUỲ CHỌN.
# Để trống thì nút Picker báo "chưa cấu hình"; chế độ chạy (demo / configured) không đổi.
# API key: Cloud Console → APIs & Services → Credentials → Create credentials → API key,
#   tạo trong CÙNG project với OAuth client. Giới hạn: API restrictions = Google Picker API;
#   Application restrictions = HTTP referrers, thêm http://localhost:3000/*.
#   Key này được gửi ra trình duyệt nên bắt buộc phải giới hạn như trên.
GOOGLE_PICKER_API_KEY=""
# Project number (chỉ gồm chữ số, KHÔNG phải project ID): Cloud Console → trang tổng quan
# (Dashboard) của project chứa OAuth client.
GOOGLE_CLOUD_PROJECT_NUMBER=""
