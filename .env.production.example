# Môi trường PRODUCTION = Vercel Production (nhánh main). Đây chỉ là danh sách biến:
# đặt giá trị trong Vercel → Settings → Environment Variables → Production. KHÔNG commit giá trị thật.
# Xem docs/01-environment.md.

NEXT_PUBLIC_APP_ENV="production"

# Bắt buộc đủ cả 5 biến: production không có chế độ demo, thiếu biến là bị chặn truy cập.

# Database production: Neon branch `main`.
# DATABASE_URL = chuỗi có pooling; DIRECT_URL = chuỗi trực tiếp, cho `prisma migrate deploy`.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"
DIRECT_URL="postgresql://user:password@ep-xxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Secret riêng cho production (32 byte, base64): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Không dùng npx auth secret: lệnh đó ghi vào .env.local của máy dev.
AUTH_SECRET=""

# OAuth client cho production. Redirect URI: https://taskeo-zeta.vercel.app/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Khoá riêng cho production (32 byte, base64). Mất khoá = không giải mã được token đã lưu.
TOKEN_ENCRYPTION_KEY=""

# Google Picker — TUỲ CHỌN, không tính vào 5 biến bắt buộc ở trên.
# Thiếu thì nút Picker báo "chưa cấu hình"; chế độ chạy không đổi.
# API key tạo trong CÙNG project với OAuth client production, giới hạn Google Picker API
# và HTTP referrer https://taskeo-zeta.vercel.app/* (key được gửi ra trình duyệt).
GOOGLE_PICKER_API_KEY=""
# Project number (chỉ chữ số, không phải project ID) ở trang tổng quan Cloud Console.
GOOGLE_CLOUD_PROJECT_NUMBER=""
